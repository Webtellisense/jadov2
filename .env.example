# Copy to .env; never commit actual credentials. PostgreSQL is required everywhere.
# This loopback URL is for the isolated passwordless cloud development database only.
DATABASE_URL=postgresql://jado@127.0.0.1:5432/jado_dev?sslmode=disable
APP_ORIGIN=http://localhost:3000
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Optional until an actual support address exists. Do not use a fabricated address.
SUPPORT_EMAIL=

# M0 cannot enable live providers, even when these flags are true.
# Future implementation requires credentials, explicit spend approval and a positive cap.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_SPEND_CAP_USD=0
GOOGLE_BUSINESS_PROFILE_ENABLED=false
GOOGLE_BUSINESS_PROFILE_SPEND_CAP_USD=0
AI_ENABLED=false
AI_SPEND_CAP_USD=0
WHATSAPP_ENABLED=false
WHATSAPP_SPEND_CAP_USD=0
EMAIL_ENABLED=false
EMAIL_SPEND_CAP_USD=0
STORAGE_ENABLED=false
STORAGE_SPEND_CAP_USD=0

# Explicit opt-in for local fixtures only; seed refuses non-local/non-dev databases.
ALLOW_DEV_SEED=false
DEV_SEED_PASSWORD=

# Deployment: local / staging / production. Discovery reads DATABASE_URL without runtime fixture switches.
APP_ENV=local
# ALLOW_DEV_SEED is a one-off CLI opt-in. Never set it on the production deployment.
# Staging uses its own DATABASE_URL; main production uses separate unseeded credentials.
